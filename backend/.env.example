# Cổng chạy API
PORT=4000

# Chuỗi kết nối PostgreSQL (khớp với service "db" trong docker-compose.yml)
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5433/brewlite?schema=public

# CSDL riêng cho integration test (sẽ bị reset mỗi lần chạy test:int)
DATABASE_URL_TEST=postgresql://brewlite:brewlite@localhost:5433/brewlite_test?schema=public

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Origin của frontend được phép gọi API (CORS), phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000

# Độ trễ giả lập của cổng thanh toán (ms)
MOCK_PAYMENT_DELAY_MS=600
